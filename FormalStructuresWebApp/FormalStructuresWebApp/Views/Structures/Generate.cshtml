@model FormalStructuresWebApp.Models.ViewModels.StructureEditorViewModel

@{
    ViewData["Title"] = "Generowanie automatu";
}

<h1>Generowanie automatu</h1>

<form asp-action="Generate" method="post">
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="5" cols="80"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <button type="submit">Generuj</button>
</form>

@if (Model.Automaton != null)
{
    <hr />
    <h2>Wygenerowany automat</h2>

    <p><strong>Nazwa:</strong> @Model.Automaton.Name</p>
    <p><strong>Stan początkowy:</strong> @Model.Automaton.StartState</p>
    <p><strong>Stany akceptujące:</strong> @string.Join(", ", Model.Automaton.AcceptingStates)</p>

    <h3>Stany</h3>
    <ul>
        @foreach (var state in Model.Automaton.States)
        {
            <li>
                @state.Name
                @(state.IsStart ? " [start]" : "")
                @(state.IsAccepting ? " [accepting]" : "")
            </li>
        }
    </ul>

    <h3>Alfabet</h3>
    <p>@string.Join(", ", Model.Automaton.Alphabet)</p>

    <h3>Przejścia</h3>
    <ul>
        @foreach (var transition in Model.Automaton.Transitions)
        {
            <li>@transition.FromState --(@transition.Symbol)--> @transition.ToState</li>
        }
    </ul>

    @if (Model.ValidationResult != null)
    {
        <h3>Walidacja</h3>

        @if (Model.ValidationResult.IsValid)
        {
            <p>Struktura jest poprawna.</p>
        }
        else
        {
            <ul>
                @foreach (var error in Model.ValidationResult.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    }

    @if (Model.AnalysisMessages.Any())
    {
        <h3>Analiza</h3>
        <ul>
            @foreach (var message in Model.AnalysisMessages)
            {
                <li>@message</li>
            }
        </ul>
    }
}