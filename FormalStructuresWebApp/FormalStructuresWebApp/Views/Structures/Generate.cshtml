@model FormalStructuresWebApp.Models.ViewModels.StructureEditorViewModel

@{
    ViewData["Title"] = "Generator automatów";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --ink: #0f0f0f;
        --ink-soft: #3a3a3a;
        --ink-muted: #7a7a7a;
        --paper: #f7f4ef;
        --paper-dark: #ede9e1;
        --accent: #1a4a8a;
        --accent-light: #e8f0fb;
        --green: #1a6a3a;
        --green-light: #e8f5ee;
        --red: #8a1a1a;
        --red-light: #faeaea;
        --border: #d4cfc6;
    }

    body { background: var(--paper); color: var(--ink); font-family: 'DM Sans', sans-serif; }

    .gen-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
    }

    /* PAGE HEADER */
    .page-header {
        border-bottom: 2px solid var(--ink);
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
    }

    .page-header-left .label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 0.5rem;
    }

    .page-header h1 {
        font-family: 'DM Serif Display', serif;
        font-size: 2.4rem;
        margin: 0;
        line-height: 1.05;
    }

    .page-header h1 em { font-style: italic; color: var(--accent); }

    .back-link {
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--ink-muted);
        text-decoration: none;
        text-transform: uppercase;
    }

    .back-link:hover { color: var(--ink); }

    /* FORM SECTION */
    .form-section {
        border: 1.5px solid var(--border);
        margin-bottom: 2.5rem;
        overflow: hidden;
    }

    .section-header {
        background: var(--ink);
        color: var(--paper);
        padding: 0.8rem 1.8rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .section-header .num {
        font-family: 'DM Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        opacity: 0.5;
    }

    .section-header strong {
        font-family: 'DM Serif Display', serif;
        font-size: 1rem;
        font-weight: normal;
    }

    .section-body {
        padding: 2rem;
        background: white;
    }

    .field-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 0.6rem;
        display: block;
    }

    .form-textarea {
        width: 100%;
        border: 1.5px solid var(--border);
        background: var(--paper);
        padding: 1rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem;
        color: var(--ink);
        resize: vertical;
        min-height: 110px;
        box-sizing: border-box;
        transition: border-color 0.15s;
        outline: none;
    }

    .form-textarea:focus { border-color: var(--accent); }

    .form-input {
        border: 1.5px solid var(--border);
        background: var(--paper);
        padding: 0.65rem 1rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.85rem;
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s;
        width: 220px;
    }

    .form-input:focus { border-color: var(--accent); }

    .form-row {
        display: flex;
        gap: 2rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .form-field { flex: 1; }
    .form-field-narrow { flex: 0 0 auto; }

    .hint {
        font-size: 0.78rem;
        color: var(--ink-muted);
        margin-top: 0.4rem;
        font-weight: 300;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--accent);
        color: white;
        border: none;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.85rem 2rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-submit:hover { background: #0f2f5c; }

    .validation-error {
        color: var(--red);
        font-size: 0.8rem;
        font-family: 'DM Mono', monospace;
        margin-top: 0.4rem;
    }

    /* LOADING INDICATOR */
    .loading-bar {
        display: none;
        background: var(--accent-light);
        border: 1.5px solid var(--accent);
        padding: 1rem 1.8rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent);
        letter-spacing: 0.08em;
        margin-bottom: 2rem;
        align-items: center;
        gap: 0.8rem;
    }

    .loading-bar.active { display: flex; }

    .spinner {
        width: 14px;
        height: 14px;
        border: 2px solid var(--accent-light);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* RESULTS */
    .results-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border: 1.5px solid var(--border);
        margin-bottom: 2rem;
    }

    .result-panel {
        padding: 1.8rem;
        border-right: 1.5px solid var(--border);
        background: white;
    }

    .result-panel:last-child { border-right: none; }

    .result-panel-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 1.2rem;
    }

    /* AUTOMATON INFO TABLE */
    .info-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
        margin-bottom: 1.5rem;
    }

    .info-table td {
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
    }

    .info-table td:first-child {
        font-family: 'DM Mono', monospace;
        font-size: 0.72rem;
        color: var(--ink-muted);
        width: 40%;
        padding-right: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .info-table tr:last-child td { border-bottom: none; }

    /* STATE TAGS */
    .state-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.8rem 0; }

    .state-tag {
        font-family: 'DM Mono', monospace;
        font-size: 0.72rem;
        padding: 0.25rem 0.6rem;
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink);
    }

    .state-tag.start { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }
    .state-tag.accepting { border-color: var(--green); color: var(--green); background: var(--green-light); }

    /* TRANSITIONS */
    .transition-list { display: flex; flex-direction: column; gap: 0.3rem; }

    .transition-item {
        font-family: 'DM Mono', monospace;
        font-size: 0.78rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.6rem;
        background: var(--paper);
        border-left: 2px solid var(--border);
    }

    .transition-item .sym {
        background: var(--ink);
        color: var(--paper);
        padding: 0.1rem 0.4rem;
        font-size: 0.68rem;
    }

    .transition-item .arrow { color: var(--ink-muted); }

    /* VALIDATION */
    .validation-ok {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--green-light);
        border: 1px solid var(--green);
        padding: 0.7rem 1rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        color: var(--green);
        margin-bottom: 1rem;
    }

    .validation-err {
        background: var(--red-light);
        border: 1px solid var(--red);
        padding: 0.7rem 1rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        color: var(--red);
        margin-bottom: 1rem;
    }

    .analysis-item {
        font-size: 0.85rem;
        color: var(--ink-soft);
        padding: 0.35rem 0;
        border-bottom: 1px solid var(--border);
        font-weight: 300;
        display: flex;
        justify-content: space-between;
    }

    .analysis-item:last-child { border-bottom: none; }

    .analysis-item span {
        font-family: 'DM Mono', monospace;
        font-size: 0.8rem;
        color: var(--ink);
    }

    /* RAW RESPONSES */
    .raw-section {
        border: 1.5px solid var(--border);
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .raw-toggle {
        width: 100%;
        background: var(--paper-dark);
        border: none;
        padding: 0.9rem 1.8rem;
        text-align: left;
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .raw-toggle:hover { color: var(--ink); }

    .raw-body {
        display: none;
        background: #1a1a1a;
        padding: 1.2rem 1.8rem;
        max-height: 280px;
        overflow-y: auto;
    }

    .raw-body.open { display: block; }

    .raw-item {
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        color: #aaa;
        padding: 0.2rem 0;
        border-bottom: 1px solid #2a2a2a;
    }

    .raw-item .word { color: #7eb8f7; }
    .raw-item .tak { color: #7ef7a0; }
    .raw-item .nie { color: #f77e7e; }

    /* GRAPH */
    .graph-section {
        border: 1.5px solid var(--border);
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .graph-section .section-header { background: var(--accent); }

    #automatonGraphWrapper {
        position: relative;
        width: 100%;
        height: 480px;
        background: white;
    }

    #automatonGraph { position: absolute; inset: 0; }
    #automatonOverlay { position: absolute; inset: 0; pointer-events: none; }

    .graph-actions {
        padding: 1.2rem 1.8rem;
        background: var(--paper-dark);
        border-top: 1.5px solid var(--border);
        display: flex;
        gap: 1rem;
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.65rem 1.3rem;
        text-decoration: none;
        transition: all 0.15s;
        border: 1.5px solid var(--ink);
        color: var(--ink);
        background: transparent;
        cursor: pointer;
    }

    .btn-action:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
    .btn-action.primary { background: var(--accent); border-color: var(--accent); color: white; }
    .btn-action.primary:hover { background: #0f2f5c; border-color: #0f2f5c; color: white; }

    @@media (max-width: 768px) {
        .results-grid { grid-template-columns: 1fr; }
        .result-panel { border-right: none; border-bottom: 1.5px solid var(--border); }
        .form-row { flex-direction: column; gap: 1rem; }
    }
</style>

<div class="gen-wrap">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-left">
            <div class="label">Generator &nbsp;·&nbsp; L* Algorithm</div>
            <h1>Generowanie <em>automatu</em></h1>
        </div>
        <a href="/" class="back-link">← Strona główna</a>
    </div>

    <!-- LOADING -->
    <div class="loading-bar" id="loadingBar">
        <div class="spinner"></div>
        Trwa uczenie automatu — zapytania do modelu językowego...
    </div>

    <!-- FORM -->
    <div class="form-section">
        <div class="section-header">
            <span class="num">01</span>
            <strong>Opis języka formalnego</strong>
        </div>
        <div class="section-body">
            <form asp-action="Generate" method="post" id="generateForm">
                <div style="margin-bottom: 1.5rem;">
                    <label class="field-label" asp-for="Description">Opis słowny języka</label>
                    <textarea class="form-textarea" asp-for="Description" rows="4"
                        placeholder="np. Skonstruuj automat dla alfabetu {a,b}, dla języka w którym każde słowo kończy się na b"></textarea>
                    <span class="validation-error" asp-validation-for="Description"></span>
                    <div class="hint">Podaj alfabet w nawiasach klamrowych, np. {0,1} lub {a,b}. System automatycznie go wykryje.</div>
                </div>

                <div class="form-row">
                    @* <div class="form-field-narrow">
                        <label class="field-label" for="Alphabet">Alfabet (opcjonalnie)</label>
                        <input class="form-input" name="Alphabet" id="Alphabet"
                               value="@Model.Alphabet"
                               placeholder="np. a,b lub 0,1" />
                        <div class="hint">Zostaw puste — system wykryje z opisu.</div>
                    </div> *@
                    <div class="form-field" style="display:flex; align-items:flex-end;">
                        <button type="submit" class="btn-submit" id="submitBtn">
                            ▶ &nbsp; Generuj automat
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Automaton != null)
    {
        <!-- RAW RESPONSES -->
        @if (Model.RawOllamaResponses.Any())
        {
            <div class="raw-section">
                <button class="raw-toggle" onclick="toggleRaw(this)">
                    <span>Surowe odpowiedzi modelu (@Model.RawOllamaResponses.Count zapytań)</span>
                    <span id="rawArrow">▼ rozwiń</span>
                </button>
                <div class="raw-body" id="rawBody">
                    @foreach (var r in Model.RawOllamaResponses)
                    {
                        var parts = r.Split('→');
                        var word = parts.Length > 0 ? parts[0].Trim() : r;
                        var ans = parts.Length > 1 ? parts[1].Trim() : "";
                        var ansClass = ans.ToUpper().Contains("TAK") ? "tak" : ans.ToUpper().Contains("NIE") ? "nie" : "";
                        <div class="raw-item">
                            <span class="word">@word</span>
                            <span> → </span>
                            <span class="@ansClass">@ans</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- RESULTS GRID -->
        <div class="results-grid">
            <!-- LEFT: automaton info -->
            <div class="result-panel">
                <div class="result-panel-label">02 &nbsp;— Wygenerowany automat</div>

                <table class="info-table">
                    <tr>
                        <td>Nazwa</td>
                        <td>@Model.Automaton.Name</td>
                    </tr>
                    <tr>
                        <td>Stan początkowy</td>
                        <td><span class="state-tag start">@Model.Automaton.StartState</span></td>
                    </tr>
                    <tr>
                        <td>Alfabet</td>
                        <td><span style="font-family:'DM Mono',monospace; font-size:0.85rem;">{ @string.Join(", ", Model.Automaton.Alphabet) }</span></td>
                    </tr>
                </table>

                <div class="result-panel-label" style="margin-bottom:0.5rem;">Stany</div>
                <div class="state-list">
                    @foreach (var state in Model.Automaton.States)
                    {
                        var cls = state.IsStart ? "start" : state.IsAccepting ? "accepting" : "";
                        <span class="state-tag @cls">
                            @state.Name
                            @(state.IsStart ? " ▶" : "")
                            @(state.IsAccepting ? " ✓" : "")
                        </span>
                    }
                </div>

                <div class="result-panel-label" style="margin: 1.2rem 0 0.5rem;">Przejścia</div>
                <div class="transition-list">
                    @foreach (var t in Model.Automaton.Transitions)
                    {
                        <div class="transition-item">
                            <span>@t.FromState</span>
                            <span class="sym">@t.Symbol</span>
                            <span class="arrow">→</span>
                            <span>@t.ToState</span>
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT: validation + analysis -->
            <div class="result-panel">
                <div class="result-panel-label">03 &nbsp;— Walidacja i analiza</div>

                @if (Model.ValidationResult != null)
                {
                    @if (Model.ValidationResult.IsValid)
                    {
                        <div class="validation-ok">✓ &nbsp; Struktura jest poprawna</div>
                    }
                    else
                    {
                        <div class="validation-err">
                            @foreach (var err in Model.ValidationResult.Errors)
                            {
                                <div>✗ @err</div>
                            }
                        </div>
                    }
                }

                @if (Model.AnalysisMessages.Any())
                {
                    <div class="analysis-item" style="font-weight:500; font-size:0.78rem; color:var(--ink-muted); text-transform:uppercase; letter-spacing:0.08em; font-family:'DM Mono',monospace; border-bottom:1.5px solid var(--ink); margin-bottom:0.2rem;">
                        Właściwości
                    </div>
                    @foreach (var msg in Model.AnalysisMessages)
                    {
                        var parts2 = msg.Split(':');
                        <div class="analysis-item">
                            <span>@(parts2.Length > 0 ? parts2[0] : msg)</span>
                            @if (parts2.Length > 1)
                            {
                                <span>@parts2[1].Trim()</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- GRAPH -->
        <div class="graph-section">
            <div class="section-header">
                <span class="num" style="opacity:0.6;">04</span>
                <strong>Wizualizacja grafu automatu</strong>
            </div>

            <div id="automatonGraphWrapper">
                <div id="automatonGraph"></div>
                <canvas id="automatonOverlay"></canvas>
            </div>

            <div class="graph-actions">
                <a asp-action="Editor" class="btn-action primary">✎ &nbsp; Edytuj graficznie</a>
                @* <a asp-action="Edit" class="btn-action">⊞ &nbsp; Edytuj dane</a> *@
            </div>
        </div>

        <script id="automaton-data" type="application/json">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Automaton,
                new System.Text.Json.JsonSerializerOptions {
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                }))
        </script>
    }

</div>

@section Scripts {
    <script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>
    <script src="~/js/graph-editor.js"></script>
    <script>
        document.getElementById('generateForm').addEventListener('submit', function () {
            document.getElementById('loadingBar').classList.add('active');
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = 'Generowanie...';
        });

        function toggleRaw(btn) {
            const body = document.getElementById('rawBody');
            const arrow = document.getElementById('rawArrow');
            body.classList.toggle('open');
            arrow.textContent = body.classList.contains('open') ? '▲ zwiń' : '▼ rozwiń';
        }
    </script>
}
