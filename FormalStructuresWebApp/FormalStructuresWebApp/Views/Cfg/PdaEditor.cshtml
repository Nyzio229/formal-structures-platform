@model FormalStructuresWebApp.Models.Domain.PushdownAutomaton

@{
    ViewData["Title"] = "Edytor PDA";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --ink: #0f0f0f; --ink-soft: #3a3a3a; --ink-muted: #7a7a7a;
        --paper: #f7f4ef; --paper-dark: #ede9e1;
        --accent: #1a4a8a; --accent-light: #e8f0fb;
        --green: #1a6a3a; --green-light: #e8f5ee;
        --red: #8a1a1a; --red-light: #faeaea; --border: #d4cfc6;
    }

    body { background: var(--paper); color: var(--ink);
           font-family: 'DM Sans', sans-serif; }

    .wrap { max-width: 1300px; margin: 0 auto; padding: 3rem 2rem 5rem; }

    .page-header {
        border-bottom: 2px solid var(--ink); padding-bottom: 1.5rem;
        margin-bottom: 2.5rem; display: flex;
        align-items: flex-end; justify-content: space-between;
    }

    .page-header .label {
        font-family: 'DM Mono', monospace; font-size: 0.65rem;
        letter-spacing: 0.18em; text-transform: uppercase;
        color: var(--ink-muted); margin-bottom: 0.5rem;
    }

    .page-header h1 { font-family: 'DM Serif Display', serif;
                      font-size: 2.4rem; margin: 0; }
    .page-header h1 em { font-style: italic; color: var(--accent); }

    .back-link { font-family: 'DM Mono', monospace; font-size: 0.7rem;
                 letter-spacing: 0.1em; color: var(--ink-muted);
                 text-decoration: none; text-transform: uppercase; }
    .back-link:hover { color: var(--ink); }

    .main-layout { display: grid;
                   grid-template-columns: 1fr 360px;
                   gap: 2rem; align-items: start; }

    .section-box { border: 1.5px solid var(--border);
                   overflow: hidden; margin-bottom: 1.5rem; }

    .section-header {
        background: var(--ink); color: var(--paper);
        padding: 0.8rem 1.8rem; display: flex; align-items: center; gap: 1rem;
    }
    .section-header.blue { background: var(--accent); }
    .section-header .num { font-family: 'DM Mono', monospace;
                           font-size: 0.6rem; letter-spacing: 0.15em; opacity: 0.5; }
    .section-header strong { font-family: 'DM Serif Display', serif;
                             font-size: 1rem; font-weight: normal; }

    #pdaGraphWrapper { position: relative; width: 100%;
                       height: 520px; background: white; }
    #pdaGraph { position: absolute; inset: 0; }
    #pdaOverlay { position: absolute; inset: 0; pointer-events: none; }

    .toolbar {
        padding: 1rem 1.8rem; background: var(--paper-dark);
        border-top: 1.5px solid var(--border);
        display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;
    }
    .toolbar-sep { width: 1px; height: 28px;
                   background: var(--border); margin: 0 0.2rem; }

    .btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-family: 'DM Mono', monospace; font-size: 0.68rem;
        letter-spacing: 0.06em; text-transform: uppercase;
        padding: 0.55rem 1rem; border: 1.5px solid var(--ink);
        color: var(--ink); background: transparent;
        cursor: pointer; transition: all 0.15s; white-space: nowrap;
    }
    .btn:hover, .btn.active { background: var(--ink); color: var(--paper); }
    .btn.blue { background: var(--accent); border-color: var(--accent);
                color: white; }
    .btn.blue:hover { background: #0f2f5c; }

    /* Dialog przejścia */
    .trans-dialog {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.5);
        align-items: center; justify-content: center; z-index: 1000;
    }
    .trans-dialog-box {
        background: white; border: 2px solid var(--ink);
        padding: 2rem; min-width: 360px;
    }
    .trans-dialog-box h3 {
        font-family: 'DM Serif Display', serif;
        font-size: 1.2rem; margin: 0 0 1.5rem;
    }
    .dialog-field { margin-bottom: 1rem; }
    .dialog-label {
        font-family: 'DM Mono', monospace; font-size: 0.65rem;
        letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--ink-muted); display: block; margin-bottom: 0.4rem;
    }
    .dialog-input {
        width: 100%; border: 1.5px solid var(--border);
        background: var(--paper); padding: 0.6rem 0.8rem;
        font-family: 'DM Mono', monospace; font-size: 0.85rem;
        color: var(--ink); outline: none; box-sizing: border-box;
    }
    .dialog-input:focus { border-color: var(--accent); }
    .dialog-hint { font-size: 0.75rem; color: var(--ink-muted);
                   margin-top: 0.3rem; font-weight: 300; }
    .dialog-buttons { display: flex; gap: 0.8rem; margin-top: 1.5rem; }

    /* Panel identyfikacji */
    .identify-panel { border: 1.5px solid var(--border); overflow: hidden; }
    .identify-body { padding: 1.5rem; background: white; }
    .btn-identify {
        display: flex; align-items: center; justify-content: center;
        gap: 0.7rem; width: 100%;
        font-family: 'DM Mono', monospace; font-size: 0.78rem;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 1rem; background: var(--accent); border: none;
        color: white; cursor: pointer; transition: background 0.15s;
    }
    .btn-identify:hover { background: #0f2f5c; }
    .btn-identify:disabled { background: #8a9ab8; cursor: not-allowed; }

    .spinner-sm {
        width: 13px; height: 13px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white; border-radius: 50%;
        animation: spin 0.7s linear infinite; display: none;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .spinner-sm.active { display: inline-block; }

    .result-box { display: none; padding: 1.5rem;
                  background: white; border-top: 1.5px solid var(--border); }
    .result-box.visible { display: block; }
    .result-label { font-family: 'DM Mono', monospace; font-size: 0.62rem;
                    letter-spacing: 0.15em; text-transform: uppercase;
                    color: var(--ink-muted); margin-bottom: 1rem; }
    .result-text { font-size: 0.88rem; color: var(--ink-soft);
                   line-height: 1.7; white-space: pre-wrap; font-weight: 300; }

    .error-box { display: none; padding: 1rem 1.5rem;
                 background: var(--red-light);
                 border-top: 1.5px solid var(--red); }
    .error-box.visible { display: block; }
    .error-text { font-family: 'DM Mono', monospace;
                  font-size: 0.75rem; color: var(--red); }

    .stats-table { width: 100%; font-size: 0.82rem; border-collapse: collapse; }
    .stats-table td { padding: 0.4rem 0; border-bottom: 1px solid var(--border); }
    .stats-table td:first-child {
        font-family: 'DM Mono', monospace; font-size: 0.68rem;
        color: var(--ink-muted); text-transform: uppercase; width: 45%;
        padding-right: 0.8rem;
    }
    .stats-table tr:last-child td { border-bottom: none; }

    .sel-info { font-family: 'DM Mono', monospace;
                font-size: 0.78rem; color: var(--ink-muted); }

    @@media (max-width: 900px) {
        .main-layout { grid-template-columns: 1fr; }
    }
</style>

<!-- Dialog dodawania przejścia -->
<div class="trans-dialog" id="transDialog">
    <div class="trans-dialog-box">
        <h3>Dodaj przejście</h3>
        <p style="font-family:'DM Mono',monospace; font-size:0.75rem;
                  color:var(--ink-muted); margin-bottom:1.5rem;">
            <span id="dialogFrom" style="color:var(--accent)"></span>
            → <span id="dialogTo" style="color:var(--accent)"></span>
        </p>

        <div class="dialog-field">
            <label class="dialog-label">Symbol wejściowy</label>
            <input class="dialog-input" id="transInput"
                   placeholder="np. a  (zostaw puste = ε)" />
            <div class="dialog-hint">Zostaw puste dla przejścia epsilon (ε)</div>
        </div>

        <div class="dialog-field">
            <label class="dialog-label">Szczyt stosu (pop)</label>
            <input class="dialog-input" id="transStackTop"
                   placeholder="np. A lub Z" />
            <div class="dialog-hint">Symbol który musi być na szczycie stosu</div>
        </div>

        <div class="dialog-field">
            <label class="dialog-label">Push na stos</label>
            <input class="dialog-input" id="transPush"
                   placeholder="np. A B  lub  ε  (zostaw puste = pop)" />
            <div class="dialog-hint">
                Symbole oddzielone spacją — pierwszy trafi na wierzch.
                Zostaw puste = samo pop (ε).
            </div>
        </div>

        <div class="dialog-buttons">
            <button class="btn blue" id="dialogConfirm">✓ Dodaj</button>
            <button class="btn" id="dialogCancel">Anuluj</button>
        </div>
    </div>
</div>

<div class="wrap">

    <div class="page-header">
        <div>
            <div class="label">Edytor &nbsp;·&nbsp; Pushdown Automaton</div>
            <h1>Edytor <em>automatu ze stosem</em></h1>
        </div>
        <a href="/" class="back-link">← Strona główna</a>
    </div>

    <div class="main-layout">

        <!-- LEWA: edytor graficzny -->
        <div>
            <div class="section-box">
                <div class="section-header">
                    <span class="num">01</span>
                    <strong>Graf automatu</strong>
                </div>

                <div id="pdaGraphWrapper">
                    <div id="pdaGraph"></div>
                    <canvas id="pdaOverlay"></canvas>
                </div>

                <div class="toolbar">
                    <button class="btn" id="addStateBtn">+ Stan</button>
                    <button class="btn" id="removeStateBtn">✕ Stan</button>
                    <div class="toolbar-sep"></div>
                    <button class="btn" id="addTransBtn">⇒ Dodaj przejście</button>
                    <button class="btn" id="removeTransBtn">✕ Przejście</button>
                    <div class="toolbar-sep"></div>
                    <button class="btn" id="saveLayoutBtn">💾 Zapisz układ</button>
                </div>
            </div>

            <div class="section-box">
                <div style="padding: 0.8rem 1.8rem; background: white;
                            display:flex; align-items:center; gap:0.8rem;">
                    <span style="font-family:'DM Mono',monospace; font-size:0.65rem;
                                 text-transform:uppercase; letter-spacing:0.1em;
                                 color:var(--ink-muted);">Zaznaczony:</span>
                    <span id="selectionInfo" class="sel-info">Nic nie zaznaczono.</span>
                </div>
            </div>
        </div>

        <!-- PRAWA: identyfikacja + statystyki -->
        <div>

            <div class="identify-panel">
                <div class="section-header blue">
                    <span class="num">02</span>
                    <strong>Identyfikacja języka</strong>
                </div>
                <div class="identify-body">
                    <p style="font-size:0.82rem; color:var(--ink-muted);
                               margin-bottom:1.2rem; font-weight:300; line-height:1.6;">
                        Narysuj PDA, a następnie kliknij przycisk — algorytm
                        zasymuluje automat na przykładowych słowach i przekaże
                        wyniki modelowi do opisu języka.
                    </p>
                    <button class="btn-identify" id="identifyBtn">
                        <div class="spinner-sm" id="identifySpinner"></div>
                        <span id="identifyBtnText">🔍 &nbsp; Identyfikuj język</span>
                    </button>
                </div>

                <div class="result-box" id="resultBox">
                    <div class="result-label">Wynik analizy</div>
                    <div class="result-text" id="resultText"></div>
                </div>

                <div class="error-box" id="errorBox">
                    <div class="error-text" id="errorText"></div>
                </div>
            </div>

            <div class="section-box" style="margin-top: 1.5rem;">
                <div class="section-header">
                    <span class="num">03</span>
                    <strong>Struktura automatu</strong>
                </div>
                <div style="padding: 1rem 1.5rem; background: white;">
                    <table class="stats-table">
                        <tr>
                            <td>Stany</td>
                            <td id="statsStates">—</td>
                        </tr>
                        <tr>
                            <td>Przejścia</td>
                            <td id="statsTransitions">—</td>
                        </tr>
                        <tr>
                            <td>Alfabet wej.</td>
                            <td id="statsAlphabet">—</td>
                        </tr>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<script id="pda-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model,
                new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }))
</script>

@section Scripts {
    <script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>
    <script src="~/js/pda-editor.js"></script>
    <script>
        // Identyfikacja języka
        document.getElementById("identifyBtn").addEventListener("click", async function () {
            const btn       = this;
            const spinner   = document.getElementById("identifySpinner");
            const btnText   = document.getElementById("identifyBtnText");
            const resultBox = document.getElementById("resultBox");
            const resultText= document.getElementById("resultText");
            const errorBox  = document.getElementById("errorBox");
            const errorText = document.getElementById("errorText");

            resultBox.classList.remove("visible");
            errorBox.classList.remove("visible");
            btn.disabled = true;
            spinner.classList.add("active");
            btnText.textContent = "Analizuję...";

            try {
                const res  = await fetch("/api/pda/identify-language",
                    { method: "POST",
                      headers: { "Content-Type": "application/json" } });
                const data = await res.json();

                if (!res.ok) {
                    errorText.textContent = data.error || "Nieznany błąd.";
                    errorBox.classList.add("visible");
                } else {
                    resultText.textContent = data.description;
                    resultBox.classList.add("visible");
                }
            } catch (err) {
                errorText.textContent = "Błąd połączenia: " + err.message;
                errorBox.classList.add("visible");
            } finally {
                btn.disabled = false;
                spinner.classList.remove("active");
                btnText.textContent = "🔍 \u00a0 Identyfikuj język";
            }
        });
    </script>
}