@model FormalStructuresWebApp.Models.ViewModels.CfgViewModel

@{
    ViewData["Title"] = "Generator PDA";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --ink: #0f0f0f;
        --ink-soft: #3a3a3a;
        --ink-muted: #7a7a7a;
        --paper: #f7f4ef;
        --paper-dark: #ede9e1;
        --accent: #1a4a8a;
        --accent-light: #e8f0fb;
        --green: #1a6a3a;
        --green-light: #e8f5ee;
        --red: #8a1a1a;
        --red-light: #faeaea;
        --border: #d4cfc6;
    }

    body {
        background: var(--paper);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
    }

    .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
    }

    .page-header {
        border-bottom: 2px solid var(--ink);
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

        .page-header .label {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-bottom: 0.5rem;
        }

        .page-header h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 2.4rem;
            margin: 0;
        }

            .page-header h1 em {
                font-style: italic;
                color: var(--accent);
            }

    .back-link {
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--ink-muted);
        text-decoration: none;
        text-transform: uppercase;
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* LOADING */
    .loading-bar {
        display: none;
        background: var(--accent-light);
        border: 1.5px solid var(--accent);
        padding: 1rem 1.8rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent);
        letter-spacing: 0.08em;
        margin-bottom: 2rem;
        align-items: center;
        gap: 0.8rem;
    }

        .loading-bar.active {
            display: flex;
        }

    .spinner {
        width: 14px;
        height: 14px;
        border: 2px solid var(--accent-light);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* FORM */
    .form-section {
        border: 1.5px solid var(--border);
        margin-bottom: 2.5rem;
        overflow: hidden;
    }

    .section-header {
        background: var(--ink);
        color: var(--paper);
        padding: 0.8rem 1.8rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .section-header .num {
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 0.15em;
            opacity: 0.5;
        }

        .section-header strong {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            font-weight: normal;
        }

        .section-header.blue {
            background: var(--accent);
        }

        .section-header.green {
            background: var(--green);
        }

    .section-body {
        padding: 2rem;
        background: white;
    }

    .field-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 0.6rem;
        display: block;
    }

    .form-textarea {
        width: 100%;
        border: 1.5px solid var(--border);
        background: var(--paper);
        padding: 1rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem;
        color: var(--ink);
        resize: vertical;
        min-height: 110px;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.15s;
    }

        .form-textarea:focus {
            border-color: var(--accent);
        }

    .form-input {
        border: 1.5px solid var(--border);
        background: var(--paper);
        padding: 0.65rem 1rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.85rem;
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s;
        width: 220px;
    }

        .form-input:focus {
            border-color: var(--accent);
        }

    .hint {
        font-size: 0.78rem;
        color: var(--ink-muted);
        margin-top: 0.4rem;
        font-weight: 300;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--accent);
        color: white;
        border: none;
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.85rem 2rem;
        cursor: pointer;
        transition: background 0.15s;
        margin-top: 1.5rem;
    }

        .btn-submit:hover {
            background: #0f2f5c;
        }

    .validation-error {
        color: var(--red);
        font-size: 0.8rem;
        font-family: 'DM Mono', monospace;
        margin-top: 0.4rem;
    }

    /* RESULTS */
    .result-section {
        border: 1.5px solid var(--border);
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .result-body {
        padding: 1.5rem 1.8rem;
        background: white;
    }

    .mono {
        font-family: 'DM Mono', monospace;
        font-size: 0.82rem;
        color: var(--ink-soft);
        padding: 0.25rem 0;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 1rem;
    }

        .mono:last-child {
            border-bottom: none;
        }

        .mono .lhs {
            color: var(--accent);
            min-width: 60px;
        }

        .mono .rhs {
            color: var(--ink);
        }

    /* CYK TABLE */
    .cyk-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 1rem 0;
    }

    .cyk-tag {
        font-family: 'DM Mono', monospace;
        font-size: 0.72rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--border);
        background: var(--paper);
    }

        .cyk-tag.accepted {
            border-color: var(--green);
            color: var(--green);
            background: var(--green-light);
        }

        .cyk-tag.rejected {
            border-color: var(--red);
            color: var(--red);
            background: var(--red-light);
        }

    /* PDA TRANSITIONS */
    .pda-transition {
        font-family: 'DM Mono', monospace;
        font-size: 0.78rem;
        padding: 0.4rem 0.6rem;
        border-left: 3px solid var(--border);
        margin-bottom: 0.3rem;
        background: var(--paper);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

        .pda-transition .state {
            color: var(--accent);
        }

        .pda-transition .sym {
            background: var(--ink);
            color: var(--paper);
            padding: 0.1rem 0.4rem;
            font-size: 0.68rem;
        }

            .pda-transition .sym.epsilon {
                background: var(--ink-muted);
            }

        .pda-transition .arrow {
            color: var(--ink-muted);
        }

    /* INFO PILLS */
    .info-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .info-pill {
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink-soft);
    }

    /* ERROR */
    .error-box {
        background: var(--red-light);
        border: 1.5px solid var(--red);
        padding: 1rem 1.5rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.8rem;
        color: var(--red);
        margin-bottom: 2rem;
    }

    /* RAW LLM */
    .raw-toggle {
        width: 100%;
        background: var(--paper-dark);
        border: none;
        padding: 0.9rem 1.8rem;
        text-align: left;
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
    }

        .raw-toggle:hover {
            color: var(--ink);
        }

    .raw-body {
        display: none;
        background: #1a1a1a;
        padding: 1.2rem 1.8rem;
        max-height: 240px;
        overflow-y: auto;
    }

        .raw-body.open {
            display: block;
        }

        .raw-body pre {
            font-family: 'DM Mono', monospace;
            font-size: 0.78rem;
            color: #7eb8f7;
            margin: 0;
            white-space: pre-wrap;
        }
</style>

<div class="wrap">

    <div class="page-header">
        <div>
            <div class="label">Generator &nbsp;·&nbsp; CFG → CNF → PDA</div>
            <h1>Generowanie <em>automatu ze stosem</em></h1>
        </div>
        <a href="/" class="back-link">← Strona główna</a>
    </div>

    <div class="loading-bar" id="loadingBar">
        <div class="spinner"></div>
        Trwa generowanie gramatyki i budowa PDA...
    </div>

    <!-- FORMULARZ -->
    <div class="form-section">
        <div class="section-header">
            <span class="num">01</span>
            <strong>Opis języka bezkontekstowego</strong>
        </div>
        <div class="section-body">
            <form asp-action="Generate" method="post" id="cfgForm">
                <div style="margin-bottom: 1.5rem;">
                    <label class="field-label" asp-for="Description">Opis słowny języka</label>
                    <textarea class="form-textarea" asp-for="Description" rows="4"
                              placeholder="np. Język słów postaci aⁿbⁿ dla n≥1, nad alfabetem {a,b}"></textarea>
                    <span class="validation-error" asp-validation-for="Description"></span>
                    <div class="hint">
                        Przykłady: „słowa z równą liczbą a i b", „poprawnie zagnieżdżone nawiasy", „palindromy nad {a,b}"
                    </div>
                </div>

                <div>
                    <label class="field-label" asp-for="Alphabet">Alfabet terminali</label>
                    <input class="form-input" asp-for="Alphabet" placeholder="np. a,b lub 0,1" />
                    <div class="hint">Symbole oddzielone przecinkami. Zostaw puste — model wywnioskuje z opisu.</div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    ▶ &nbsp; Generuj PDA
                </button>
            </form>
        </div>
    </div>

    @if (Model.Result != null)
    {
        @if (!Model.Result.Success)
        {
            <div class="error-box">
                ✕ &nbsp; @Model.Result.ErrorMessage
            </div>
        }
        else
        {
            <!-- RAW LLM -->
            <div class="result-section">
                <button class="raw-toggle" onclick="toggleRaw(this)">
                    <span>Surowa odpowiedź modelu (gramatyka BNF)</span>
                    <span>▼ rozwiń</span>
                </button>
                <div class="raw-body">
                    <pre>@Model.Result.RawLlmResponse</pre>
                </div>
            </div>

            <!-- GRAMATYKA ORYGINALNA -->
            <div class="result-section">
                <div class="section-header">
                    <span class="num">02</span>
                    <strong>Gramatyka CFG — wygenerowana przez model</strong>
                </div>
                <div class="result-body">
                    <div class="info-row">
                        <span class="info-pill">Symbol startowy: @Model.Result.OriginalGrammar!.StartSymbol</span>
                        <span class="info-pill">Produkcji: @Model.Result.OriginalGrammar.Productions.Count</span>
                        <span class="info-pill">
                            Nieterminale: @string.Join(", ", Model.Result.OriginalGrammar.NonTerminals)
                        </span>
                        <span class="info-pill">
                            Terminale: @string.Join(", ", Model.Result.OriginalGrammar.Terminals)
                        </span>
                    </div>
                    @foreach (var p in Model.Result.OriginalGrammar.Productions)
                    {
                        <div class="mono">
                            <span class="lhs">@p.Left</span>
                            <span style="color:var(--ink-muted)">→</span>
                            <span class="rhs">@(p.Right.Any() ? string.Join(" ", p.Right) : "ε")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- CNF -->
            <div class="result-section">
                <div class="section-header blue">
                    <span class="num">03</span>
                    <strong>Po konwersji do CNF — algorytm formalny (5 kroków)</strong>
                </div>
                <div class="result-body">
                    <div class="hint" style="margin-bottom:1rem;">
                        Każda produkcja ma postać A → BC lub A → a (wymagane przez algorytm CYK i budowę PDA).
                    </div>
                    <div class="info-row">
                        <span class="info-pill">Symbol startowy: @Model.Result.CnfGrammar!.StartSymbol</span>
                        <span class="info-pill">Produkcji: @Model.Result.CnfGrammar.Productions.Count</span>
                    </div>
                    @foreach (var p in Model.Result.CnfGrammar.Productions)
                    {
                        <div class="mono">
                            <span class="lhs">@p.Left</span>
                            <span style="color:var(--ink-muted)">→</span>
                            <span class="rhs">@(p.Right.Any() ? string.Join(" ", p.Right) : "ε")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- CYK WERYFIKACJA -->
            <div class="result-section">
                <div class="section-header green">
                    <span class="num">04</span>
                    <strong>Weryfikacja algorytmem CYK</strong>
                </div>
                <div class="result-body">
                    <div class="hint" style="margin-bottom:1rem;">
                        Każde słowo sprawdzone algorytmem CYK na gramatyce CNF — wynik jest w 100% pewny.
                    </div>
                    <div class="cyk-grid">
                        @foreach (var (word, accepted) in Model.Result.WordVerifications
                       .OrderBy(kv => kv.Key.Length).ThenBy(kv => kv.Key))
                        {
                            <span class="cyk-tag @(accepted ? "accepted" : "rejected")">
                                @(word == "" ? "ε" : word) &nbsp; @(accepted ? "✓" : "✗")
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- PDA -->
            <div class="result-section">
                <div class="section-header">
                    <span class="num">05</span>
                    <strong>Wygenerowany automat ze stosem (PDA)</strong>
                </div>
                <div class="result-body">
                    <div class="info-row">
                        <span class="info-pill">Stany: @string.Join(", ", Model.Result.Pda!.States)</span>
                        <span class="info-pill">Stan startowy: @Model.Result.Pda.StartState</span>
                        <span class="info-pill">Symbol startowy stosu: @Model.Result.Pda.StartStackSymbol</span>
                        <span class="info-pill">
                            Akceptacja: @(Model.Result.Pda.AcceptanceMode == FormalStructuresWebApp.Models.Domain.PdaAcceptanceMode.EmptyStack ? "przez pusty stos" : "przez stany akceptujące")
                        </span>
                        <span class="info-pill">
                            Alfabet wejściowy: @string.Join(", ", Model.Result.Pda.InputAlphabet)
                        </span>
                        <span class="info-pill">
                            Alfabet stosu: @string.Join(", ", Model.Result.Pda.StackAlphabet)
                        </span>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div class="field-label" style="margin-bottom: 0.8rem;">Funkcja przejść δ(stan, symbol_wej, szczyt_stosu) → (stan, push)</div>
                        @foreach (var t in Model.Result.Pda.Transitions)
                        {
                            var inp = t.InputSymbol ?? "ε";
                            var push = t.PushSymbols.Any() ? string.Join(" ", t.PushSymbols) : "ε";
                            <div class="pda-transition">
                                <span class="state">@t.FromState</span>
                                <span class="arrow">—</span>
                                <span class="sym @(t.InputSymbol == null ? "epsilon" : "")">@inp</span>
                                <span style="color:var(--ink-muted); font-size:0.7rem;">stos:</span>
                                <span class="sym">@t.StackTop</span>
                                <span class="arrow">→</span>
                                <span class="state">@t.ToState</span>
                                <span style="color:var(--ink-muted); font-size:0.7rem;">push:</span>
                                <span class="sym @(push == "ε" ? "epsilon" : "")">@push</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        document.getElementById('cfgForm').addEventListener('submit', function () {
            document.getElementById('loadingBar').classList.add('active');
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = 'Generowanie...';
        });

        function toggleRaw(btn) {
            const body = btn.nextElementSibling;
            body.classList.toggle('open');
            const arrow = btn.querySelector('span:last-child');
            arrow.textContent = body.classList.contains('open') ? '▲ zwiń' : '▼ rozwiń';
        }
    </script>
}